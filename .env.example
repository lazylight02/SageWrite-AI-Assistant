# SageWrite - Environment Configuration Template
# Copy this file to '.env' and populate with your own credentials.

# 1. Google Gemini API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (Defaults to gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase Configuration (Optional for draft generation, required for message history)
# Obtain from your Supabase project settings -> API (Project URL & anon/public API Key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key_here
